# Entrar com Google / Facebook / Microsoft no Mondego IA (login nativo do Streamlit, OpenID Connect).
# 1. Copia este ficheiro para ".streamlit/secrets.toml" (na mesma pasta) e preenche os valores.
# 2. Instala a biblioteca de autenticação:  py -3.14 -m pip install Authlib   (o iniciar.bat já o faz)
# 3. Reinicia a app. Os botões «Continuar com …» aparecem no ecrã de entrada (o do Google também se configura
#    lá: o botão «Continuar com Google» abre os passos e guarda este ficheiro por ti).
# NUNCA partilhes o secrets.toml (tem segredos). Ele não entra na exportação de dados.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "escreve-aqui-um-texto-aleatorio-comprido"   # ex.: py -3.14 -c "import secrets; print(secrets.token_hex(32))"

# --- Google (grátis): https://console.cloud.google.com/ → APIs e serviços → Credenciais → Criar credenciais →
#     ID do cliente OAuth → Aplicação Web → URI de redirecionamento autorizado: http://localhost:8501/oauth2callback
[auth.google]
client_id = "....apps.googleusercontent.com"
client_secret = "..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# --- Facebook, Microsoft, Apple… (através do Auth0, com plano gratuito): https://auth0.com → Applications → Regular Web
#     Application → Allowed Callback URLs: http://localhost:8501/oauth2callback → Authentication → Social → ativa Facebook
#     (e/ou Microsoft, Apple). Apaga esta secção se não a usares.
[auth.auth0]
client_id = "..."
client_secret = "..."
server_metadata_url = "https://O-TEU-DOMINIO.eu.auth0.com/.well-known/openid-configuration"
client_kwargs = { "prompt" = "login" }

# --- Servidor Blender (opcional): para que TODOS os utilizadores da app online tenham modelos 3D feitos no Blender.
#     Corre o servidor da pasta servidor_blender (Dockerfile) num servidor com HTTPS e põe aqui o endereço e a mesma
#     chave (MONDEGO_TOKEN). Sem esta secção, a app usa o Blender instalado no próprio computador (se houver).
[blender]
url = "https://o-teu-servidor-blender.exemplo"
token = "a-mesma-chave-longa-e-secreta-do-servidor"

# --- Chaves da app (opcional): quem gere a app pode pô-las aqui em vez de no Perfil → Administração. Numa app
#     publicada (Streamlit Community Cloud, servidor…), é aqui que ficam: os utilizadores nunca as veem.
[ia]
fornecedor = "Gemini"            # ou "Claude"
gemini = "a-chave-do-google-ai-studio"
# claude = "a-chave-da-anthropic"
# tavily = "a-chave-da-tavily"   # pesquisa em toda a web (opcional)

# --- Administradores: só estas contas veem a Administração (chaves, início de sessão, Salas online).
#     Sem esta secção, a primeira conta que entra na app fica administradora.
[admin]
emails = ["o-teu-email@exemplo.pt"]

# --- App publicada (Supabase): contas, dados de cada pessoa e Salas online. Chave anon / publishable, NUNCA a
#     service_role / secret. Passos completos no LEIA-ME → «Publicar a app».
# [supabase]
# url = "https://o-teu-projeto.supabase.co"
# chave = "a-chave-anon"

# --- Endereço público da app (para o regresso do Google pelo Supabase e para os convites das Salas).
# [app]
# url = "https://o-teu-endereco.streamlit.app"
